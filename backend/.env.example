# Copy to .env for local development. Never commit real secrets.

SERVER_PORT=8080
APP_ENV=development
RATE_LIMIT_MAX=300

# DB pool (tune down further on 1GB Lightsail)
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME_MINUTES=30
RUN_INPROCESS_CRONS=true
TRUSTED_PROXIES=nginx,172.16.0.0/12,10.0.0.0/8

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vsmartcrm_db?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vsmartcrm_db

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# auto = GORM AutoMigrate (local). production defaults to goose.
MIGRATE_MODE=auto

# lax works for localhost SPA ↔ API; production defaults to none (cross-origin)
COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:5173
REMEMBER_DEVICE_SECRET=dev-device-secret-change-me

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=rbac@app.com

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_FOLDER=uploads

IMAGE_MAX_SIZE_BYTES=1048576
IMAGE_COMPRESS_THRESHOLD_BYTES=51200
IMAGE_QUALITY=85

# WhatsApp Studio public API (Settings → API keys in Studio)
# WA_STUDIO_BASE_URL=https://wa-automation-one.vercel.app
# WA_STUDIO_API_KEY=wak_...
# WA_STUDIO_TEMPLATE_LANG=en_US
# WA_STUDIO_TEMPLATE_CREATED=ticket_created_v1
# WA_STUDIO_TEMPLATE_STATUS=ticket_status_v1
# WA_STUDIO_TEMPLATE_CLOSED=ticket_closed_v1
